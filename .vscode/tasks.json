{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mkdocs preview (serve + browser)",
      "type": "shell",
      "command": "nohup .venv/bin/mkdocs serve > /tmp/mkdocs_serve.log 2>&1 & sleep 2; open http://127.0.0.1:8000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "new",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "stop mkdocs serve",
      "type": "shell",
      "command": "pkill -f 'mkdocs serve'",
      "problemMatcher": []
    }
  ]
}
