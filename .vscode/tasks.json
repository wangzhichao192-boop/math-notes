{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mkdocs preview (serve + browser)",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/启动数学笔记.command"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "stop mkdocs serve",
      "type": "process",
      "command": "pkill",
      "args": ["-f", "mkdocs serve --config-file ${workspaceFolder}/mkdocs.yml --dev-addr"],
      "problemMatcher": []
    }
  ]
}
